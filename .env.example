# Core runtime
DATABASE_URL=sqlite:///data/database.db
# 默认仅监听本机；远程管理请通过 Tailscale Serve 转发，勿直接映射到公网。
WEB_HOST=127.0.0.1
WEB_PORT=8888
WX_BOT_PORT=5555
LOG_LEVEL=INFO
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=120
LLM_HISTORY_MAX_TEXT_CHARS=50000
WECHAT_BOT_NAME=
# Win32-only 窗口位置看护固定启用：每 5 秒检查一次，同一 HWND 连续两次异常才复位。
WECHAT_LISTENER_WINDOW_AUTO_REPAIR_INTERVAL_SEC=5
WECHAT_LISTENER_WINDOW_AUTO_REPAIR_CONFIRMATION_PROBES=2
WECHAT_LISTENER_WINDOW_AUTO_REPAIR_RETRY_COOLDOWN_SEC=30
# 入站文件自动归档：按聊天与消息隔离保存；索引用于精确解析文件引用。
WECHAT_FILE_DOWNLOAD_ROOT=tmp/wechat_files
WECHAT_FILE_INDEX_PATH=data/wechat_file_index.sqlite3
WECHAT_FILE_DOWNLOAD_TIMEOUT_SEC=60
# 设为 0 可禁用自动清理。
WECHAT_FILE_RETENTION_DAYS=30

# Comma-separated origins only when the frontend is hosted separately.
# The bundled Web console is same-origin and should leave this empty.
WEB_CORS_ORIGINS=

# AI providers (configure only the providers you use)
OPENAI_API_KEY=
LINKAI_API_KEY=
LINKAI_API_BASE=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
TIKHUB_API_TOKEN=
CODEX_PROXY_KEY=

# Codex runtime
CODEX_BINARY_POLICY=global
CODEX_CONFIG_POLICY=inherit
CODEX_PROXY_MODEL=gpt-5.6-sol
CODEX_INTERACTIVE_POOL_SIZE=1
CODEX_INTERACTIVE_PROCESS_CONCURRENCY=4
CODEX_BATCH_POOL_SIZE=1
CODEX_BATCH_PROCESS_CONCURRENCY=1
CODEX_VERSION_CHECK_INTERVAL_SECONDS=60
CODEX_POOL_DRAIN_TIMEOUT_SECONDS=60
CODEX_RUNTIME_STATE_DB=data/codex_runtime.db
CODEX_APP_SERVER_ROTATE_TOKENS=220000
CODEX_APP_SERVER_MAX_COMPACTIONS=2
CODEX_APP_SERVER_IDLE_ROTATE_SECONDS=2592000
CODEX_APP_SERVER_CONTEXT_SAFETY_TOKENS=32768
# 普通私聊与群聊的持久隔离目录；群成员共享同一个群目录。
CODEX_CHAT_SCOPE_ROOT=data/codex_chat_scopes
RUNTIME_OPERATIONS_DB=data/runtime_operations.db

# Backup format v2 includes .env as plaintext by operator choice. Keep the
# directory private and do not sync archives to an untrusted location.
SYSTEM_BACKUP_DIR=data/system_backups
SYSTEM_BACKUP_MAX_IMPORT_GB=50
# 设置为 wsl 时，完整迁移会备份并恢复 WSL Codex 中的 ppt-master；状态备份不包含。
SYSTEM_BACKUP_PPT_MASTER_DIR=wsl
CODEX_JOB_RETENTION_DAYS=30
CODEX_UPGRADE_TIMEOUT_SECONDS=600
CODEX_CIRCUIT_FAILURE_THRESHOLD=3
CODEX_CIRCUIT_RESET_SECONDS=30
CODEX_ARTIFACT_RETENTION_DAYS=30
CODEX_ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
# 单个微信引用文件交给 Codex 处理时的上限（默认 256 MiB）。
CODEX_INPUT_FILE_MAX_BYTES=268435456
# 由 Mabobot 托管的临时 Chromium 动态工具；仅允许公共网页只读访问。
CODEX_BROWSER_TOOL_ENABLED=true
CODEX_BROWSER_MAX_CONCURRENCY=1
CODEX_BROWSER_NAVIGATION_TIMEOUT_MS=90000
CODEX_BROWSER_RENDER_TIMEOUT_MS=120000
CODEX_BROWSER_MAX_REQUESTS=3000
CODEX_BROWSER_DOWNLOAD_MAX_BYTES=268435456
CODEX_BROWSER_DOWNLOAD_TIMEOUT_SECONDS=120

# External integrations
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TYPE=custom
FEISHU_BITABLE_APP_TOKEN=
QQEMAIL_ADDR=
QQEMAIL_CODE=

# Optional GetMoving-compatible video service
GROK2API_BASE_URL=http://127.0.0.1:9527/v1
grok2api_API_KEY=

# Optional Chrome integration used by summary capabilities
SUMMARY_CHROME_PATH=
SUMMARY_CHROME_DEBUG_PORT=9222
SUMMARY_CHROME_USER_DATA_DIR=
SUMMARY_CHROME_PROFILE_DIR=Default
SUMMARY_CHROME_BLOCK_IMAGES=true
