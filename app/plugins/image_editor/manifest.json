{
  "schema_version": 2,
  "plugin_api_version": 2,
  "storage": {"cache_retention_days": 7, "cache_limit_mb": 2048},
  "backup": {"schema_version": 1, "include_persistent_storage": true, "include_generated_files": true, "supports_restore_migration": true, "sensitive": false},
  "health": {"critical": false, "timeout_seconds": 5},
  "listeners": [
    {"event": "text_message_received", "handler": "handle_text_message", "title": "文本生图", "trigger": {"kind": "keyword", "summary": "以触发词开头的文本发起生图任务", "config_keys": ["trigger_keyword"], "conditions": []}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"},
    {"event": "quote_text_message_received", "handler": "handle_text_message", "title": "引用回复生图", "trigger": {"kind": "keyword", "summary": "用引用回复正文的触发词发起生图任务", "config_keys": ["trigger_keyword"], "conditions": []}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"},
    {"event": "quote_image_message_received", "handler": "handle_quote_image_message", "title": "引用图片生图", "trigger": {"kind": "keyword", "summary": "用引用回复正文的触发词发起生图任务，引用图片作为参考", "config_keys": ["trigger_keyword"], "conditions": []}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"},
    {"event": "quote_video_message_received", "handler": "handle_text_message", "title": "引用视频的回复生图", "trigger": {"kind": "keyword", "summary": "用引用回复正文的触发词发起生图任务", "config_keys": ["trigger_keyword"], "conditions": []}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"},
    {"event": "link_message_received", "handler": "handle_text_message", "title": "含网址的生图指令", "trigger": {"kind": "keyword", "summary": "命中句首触发词的文本或引用回复可以包含网址", "config_keys": ["trigger_keyword"], "conditions": []}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"}
  ],
  "jobs": []
}
